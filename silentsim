local function BypassAdonis()
    if not _G.AdonisBypass then return end

    -- 2.1 检测 Adonis
    local AdonisDetected = false
    pcall(function()
        for _, obj in ipairs(game:GetDescendants()) do
            if obj.Name == "Adonis" or obj.Name == "AntiCheat" then
                AdonisDetected = true
                break
            end
        end
    end)

    if not AdonisDetected then
        for _, name in ipairs({
            "Adonis_Remote","Adonis_AntiCheat","Adonis_Check",
            "Adonis_Validate","Adonis_Log","Adonis_Event"
        }) do
            if ReplicatedStorage:FindFirstChild(name) then
                AdonisDetected = true
                break
            end
        end
    end

    if not AdonisDetected then
        print("[v6.1] ℹ️ 未检测到 Adonis")
        return
    end

    print("[v6.1] 🛡️ 检测到 Adonis，应用 Bypass...")

    -- 2.2 屏蔽 Adonis RemoteEvents
    for _, name in ipairs({
        "Adonis_Remote","Adonis_AntiCheat","Adonis_Check",
        "Adonis_Validate","Adonis_Log","Adonis_Event"
    }) do
        local remote = ReplicatedStorage:FindFirstChild(name)
        if remote and remote:IsA("RemoteEvent") then
            pcall(function()
                remote.OnServerEvent:Connect(function() return end)
            end)
        end
    end

    -- 2.3 Hook namecall 拦截 Adonis 调用
    pcall(function()
        local mt = getrawmetatable(game)
        if not mt then return end
        local oldNC = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" or method == "InvokeServer" then
                local selfName = string.lower(tostring(self))
                if string.find(selfName, "adonis")
                    or string.find(selfName, "anticheat")
                    or string.find(selfName, "detect")
                    or string.find(selfName, "validate") then
                    return nil
                end
            end
            return oldNC(self, ...)
        end)
        setreadonly(mt, true)
    end)

    -- 2.4 清除 Adonis 全局标记（每 0.5 秒）
    task.spawn(function()
        while _G.AdonisBypass and task.wait(0.5) do
            pcall(function()
                if getgenv and getgenv().Adonis then
                    getgenv().Adonis.Detected = false
                end
                if getgenv and getgenv().adonis then
                    getgenv().adonis.Detected = false
                end
            end)
        end
    end)

    print("[v6.1] ✅ Adonis Bypass 已应用")
end

-- 延迟 3 秒执行（等游戏加载）
