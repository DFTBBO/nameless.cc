-- 自动刷新玩家列表
local function BuildPlayerListValues()
    local values = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            values[tostring(plr.UserId)] = string.format('%s (@%s)', plr.Name, plr.DisplayName)
        end
    end
    for uid, _ in pairs(_G.Blacklist) do
        local k = tostring(uid)
        if not values[k] then values[k] = '[离线] ID: ' .. k end
    end
    for uid, _ in pairs(_G.Whitelist) do
        local k = tostring(uid)
        if not values[k] then values[k] = '[离线] ID: ' .. k end
    end
    return values
end

task.spawn(function()
    -- 首次填充
    task.wait(0.5)
    pcall(function()
        local vals = BuildPlayerListValues()
        if PLBlacklistDropdown then PLBlacklistDropdown:SetValues(vals) end
        if PLWhitelistDropdown then PLWhitelistDropdown:SetValues(vals) end
    end)
    
    while task.wait(_G.PlayerListRefreshRate) do
        if _G.PlayerListEnabled then
            pcall(function()
                local vals = BuildPlayerListValues()
                if PLBlacklistDropdown then PLBlacklistDropdown:SetValues(vals) end
                if PLWhitelistDropdown then PLWhitelistDropdown:SetValues(vals) end
            end)
        end
    end
end)

