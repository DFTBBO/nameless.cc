local function RefreshLists()
    local vals = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            vals[tostring(plr.UserId)] = plr.Name
        end
    end
    pcall(function() BL_DD:SetValues(vals) end)
    pcall(function() WL_DD:SetValues(vals) end)
end

task.spawn(function()
    task.wait(1)
    RefreshLists()
    while task.wait(2) do RefreshLists() end
end)

