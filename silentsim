        if hum and root then
            createESP(char)
            HookHumanoidForDeath(char, hum)
            if not TrackedModels[char] then
                TrackedModels[char] = {Category = "Player", Player = player}
                PlayerCache[char] = {Model = char, HRP = root, Humanoid = hum, Player = player, IsNPC = false}
            end
        end
    end)
    if player.Character then
        if _G.NoSelfAim and IsLocalCharacter(player.Character) then return end
        local hum, root = getCharacterHumanoid(player.Character)
        if hum and root then
            createESP(player.Character)
            HookHumanoidForDeath(player.Character, hum)
            TrackedModels[player.Character] = {Category = "Player", Player = player}
            PlayerCache[player.Character] = {Model = player.Character, HRP = root, Humanoid = hum, Player = player, IsNPC = false}
        end
    end
end

