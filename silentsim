-- 预计算小写
local NPCTagsLower = {}
for _, tag in pairs(NPCTags) do
    NPCTagsLower[#NPCTagsLower + 1] = tag:lower()
end

local function DebugNPCDetection(character, reason)
    if not _G.DebugNPCs then return end
    print("[NPC DEBUG]", character.Name, "| Razão:", reason)
end

local function OriginalIsNPC(character)
    if not character or not character:IsA("Model") then return false end
    if IsPlayer(character) then return false end
    if IsLocalCharacter(character) then return false end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    if humanoid.Health < _G.NPCMinHealth then return false end
    if humanoid:GetState() == Enum.HumanoidStateType.Dead then return false end

    if _G.NPCRequireHRP and not character:FindFirstChild("HumanoidRootPart") then return false end
    if _G.NPCRequireHead and not character:FindFirstChild("Head") then return false end

    if _G.AggressiveNPCDetection then
        DebugNPCDetection(character, "Aggressive")
        return true
    end

    local charName = character.Name:lower()
    for i = 1, #NPCTagsLower do
        if charName:find(NPCTagsLower[i], 1, true) then
            DebugNPCDetection(character, "Tag nome: " .. NPCTagsLower[i])
            return true
        end
    end

    -- 文件夹检测（缓存文件夹列表）
    for _, folderName in pairs({"NPCs","Enemies","Bots","Mobs","Targets","Enemy","Hostile",
        "Monsters","Zombies","Creatures","Characters","Spawns","EnemySpawns",
        "NPCSpawns","Bosses","Minions"}) do
        local folder = workspace:FindFirstChild(folderName)
        if folder and character:IsDescendantOf(folder) then
            DebugNPCDetection(character, "Pasta: " .. folderName)
            return true
        end
    end

    for _, indicator in pairs({"NPC","IsNPC","IsEnemy","Hostile","Enemy","IsBot","IsMob","IsMonster","Team","Faction"}) do
        local value = character:FindFirstChild(indicator)
        if value then
            if value:IsA("BoolValue") and (indicator == "NPC" or indicator == "IsNPC" or indicator == "IsEnemy" or indicator == "Hostile") and value.Value == true then
                return true
            elseif value:IsA("StringValue") then
                local valLower = value.Value:lower()
                if valLower == "enemy" or valLower == "hostile" or valLower == "npc" or valLower == "bot" or valLower == "monster" or valLower == "mob" then
                    return true
                end
            elseif value:IsA("IntValue") and indicator == "Team" then
                return true
            end
        end
    end

    local hasAIBehavior = false
    for _, child in pairs(character:GetChildren()) do
        local childName = child.Name:lower()
        if child:IsA("Script") or child:IsA("LocalScript") then
            if childName:find("ai") or childName:find("behavior") or childName:find("path")
                or childName:find("attack") or childName:find("patrol") or childName:find("combat") then
                hasAIBehavior = true; break
            end
        end
    end

    local tags = CollectionService:GetTags(character)
    for _, tag in pairs(tags) do
        local tagLower = tag:lower()
        for i = 1, #NPCTagsLower do
            if tagLower:find(NPCTagsLower[i], 1, true) then return true end
        end
    end

    for _, ability in pairs({"Attack","Damage","Aggro","Patrol","Spawn","Respawn","AI","BehaviorTree"}) do
        if character:FindFirstChild(ability) or character:FindFirstChild(ability .. "Script") then
            hasAIBehavior = true; break
        end
    end
    if hasAIBehavior then return true end

    for _, pattern in pairs({"^npc_","^enemy_","^bot_","^mob_","_npc$","_enemy$","_bot$"}) do
        if string.match(charName, pattern) then return true end
    end

    -- 兜底
    DebugNPCDetection(character, "Generic fallback")
    return true
end

-- ✅ v5.1: 缓存判定结果到 Attribute，只算一次
local function IsNPCModel(model)
    if not model or not model:IsA("Model") then return false end
    if IsLocalCharacter(model) then return false end
    if Players:GetPlayerFromCharacter(model) then return false end

    -- 检查缓存
    local cached = model:GetAttribute("_UPC_NPC")
    if cached ~= nil then return cached end

    local result
    if _G.UseOriginalNPCDetection then
        result = OriginalIsNPC(model)
    else
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if not humanoid then result = false
        elseif humanoid.Health < _G.NPCMinHealth then result = false
        elseif humanoid:GetState() == Enum.HumanoidStateType.Dead then result = false
        elseif _G.NPCRequireHRP and not model:FindFirstChild("HumanoidRootPart") then result = false
        else result = true end
    end

    pcall(function() model:SetAttribute("_UPC_NPC", result) end)
    return result
end

