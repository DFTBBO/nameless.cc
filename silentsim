local createESPRef

local function DestroyESPForModel(model)
    local parts = ESP_Objects[model]
    if parts then
        for _, obj in pairs(parts) do
            if obj then pcall(function() obj.Visible = false end) end
            if obj and obj.Remove then pcall(function() obj:Remove() end) end
        end
        ESP_Objects[model] = nil
    end
end

local function HideESPForModel(model)
    local parts = ESP_Objects[model]
    if parts then
        for _, obj in pairs(parts) do
            if obj then pcall(function() obj.Visible = false end) end
        end
    end
end

-- ✅ v5.1: 死亡事件只挂一次
local function HookHumanoidForDeath(model, humanoid)
    if not humanoid then return end
    if humanoid:GetAttribute("_UPC_DeathHooked") then return end
    humanoid:SetAttribute("_UPC_DeathHooked", true)

    humanoid.Died:Connect(function()
        if _G.ESP_IgnoreDead and _G.ESP_ImmediateHideOnDeath then
            HideESPForModel(model)
        end
        if CurrentTarget == model then
            CurrentTarget = nil; TargetPart = nil; TargetInRange = false
        end
        NPCCache[model] = nil
        PlayerCache[model] = nil
    end)
end

-- ✅ v5.1: 分类注册（进入队列）
local function ClassifyAndRegister(model)
    if not model or not model.Parent then return end
    if TrackedModels[model] then return end
    if _G.NoSelfAim and IsLocalCharacter(model) then return end
    if #ProcessQueue > 1000 then return end  -- 队列保护

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local hrp = model:FindFirstChild("HumanoidRootPart")
    if not humanoid or not hrp then return end
    if humanoid.Health < _G.NPCMinHealth then return end

    local player = Players:GetPlayerFromCharacter(model)
    if player then
        if _G.NoSelfAim and player == LocalPlayer then return end
        TrackedModels[model] = {Category = "Player", Player = player}
        PlayerCache[model] = {Model = model, HRP = hrp, Humanoid = humanoid, Player = player, IsNPC = false}
        HookHumanoidForDeath(model, humanoid)
        task.delay(0.1, function()
            if TrackedModels[model] and model.Parent then createESPRef(model) end
        end)
        return
    end

    -- 放入队列，稍后处理
    ProcessQueue[#ProcessQueue + 1] = model
end

-- ✅ v5.1: 队列处理器
local function ProcessQueueBatch()
    if QueueProcessing then return end
    QueueProcessing = true

    local processed = 0
    while processed < _G.QueueBatchSize and #ProcessQueue > 0 do
        local model = table.remove(ProcessQueue, 1)
        processed = processed + 1

        if model and model.Parent and not TrackedModels[model] then
            local humanoid = model:FindFirstChildOfClass("Humanoid")
            local hrp = model:FindFirstChild("HumanoidRootPart")
            if humanoid and hrp and humanoid.Health >= _G.NPCMinHealth then
                if IsNPCModel(model) then
                    TrackedModels[model] = {Category = "NPC"}
                    NPCCache[model] = {Model = model, HRP = hrp, Humanoid = humanoid, IsNPC = true}
                    HookHumanoidForDeath(model, humanoid)
                    createESPRef(model)
                end
            end
        end
    end

    QueueProcessing = false
end

task.spawn(function()
    while task.wait(0.1) do
        if #ProcessQueue > 0 then
            pcall(ProcessQueueBatch)
        end
    end
end)

local function UnregisterModel(model)
    TrackedModels[model] = nil
    NPCCache[model] = nil
    PlayerCache[model] = nil
    DestroyESPForModel(model)
end

