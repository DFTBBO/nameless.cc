-- Silent Aim
-- ==================================================

local function IsEnemyPlayer(player)
    if _G.NoSelfAim and player == LocalPlayer then return false end
    if _G.BlacklistMode and not _G.Blacklist[player.UserId] then return false end
    if _G.WhitelistMode and _G.Whitelist[player.UserId] then return false end
    if not _G.TeamCheck then return true end
    if not LocalPlayer.Team or not player.Team then return true end
    if _G.FriendCheck then
        local ok, is = pcall(function() return LocalPlayer:IsFriendsWith(player.UserId) end)
        if ok and is then return false end
    end
    return LocalPlayer.Team ~= player.Team
end

local function GetAimPart(model)
    local ap = _G.AimPart
    if ap == "Head" then
        return model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
    elseif ap == "Torso" then
        return model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart")
    else
        return model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
    end
end

local function PickTarget()
    if not LocalPlayer.Character then return nil end
    local localRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not localRoot then return nil end
    local localPos = localRoot.Position

    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local bestScore = math.huge
    local bestModel, bestPart

    local function Consider(model, data, isPlayer)
        local hum = data.Humanoid
        local hrp = data.HRP
        if not hum or not hrp or hum.Health <= 0 then return end
        if _G.NoSelfAim and model == LocalPlayer.Character then return end

        if isPlayer then
            if not IsEnemyPlayer(data.Player) then return end
        else
            if _G.TeamCheckForNPCs then
                local t = model:FindFirstChild("Team")
                if t and t:IsA("StringValue") and LocalPlayer.Team and t.Value == LocalPlayer.Team.Name then
                    return
                end
            end
        end

        local dist = (hrp.Position - localPos).Magnitude
        if _G.EnableDistanceLimit and dist > _G.MaxAimDistance then return end

        local part = GetAimPart(model)
        if not part then return end
        local aimPos = part.Position
        if _G.Prediction > 0 and hrp.Velocity.Magnitude > 1 then
            aimPos = aimPos + hrp.Velocity * _G.Prediction
        end

        local screenPos, onScreen = Camera:WorldToViewportPoint(aimPos)
        if not onScreen then return end

        local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
        if distFromCenter > _G.FOV then return end

        local score
        if _G.TargetPriority == "Crosshair" then score = distFromCenter
        elseif _G.TargetPriority == "Distance" then score = dist
        elseif _G.TargetPriority == "LowestHP" then score = hum.Health
        else score = distFromCenter end

        if score < bestScore then
            bestScore = score
            bestModel = model
            bestPart = part
        end
    end

    if _G.TargetMode == "NPCs" or _G.TargetMode == "Both" then
        for model, data in pairs(ActiveNPCs) do
            Consider(model, data, false)
        end
    end
    if _G.TargetMode == "Players" or _G.TargetMode == "Both" then
        for model, data in pairs(ActivePlayers) do
            Consider(model, data, true)
        end
    end

    return bestModel, bestPart
end

local function ValidateCurrent()
    if not CurrentTarget or not TargetPart then return false end
    if not CurrentTarget.Parent or not TargetPart.Parent then return false end
    if _G.NoSelfAim and CurrentTarget == LocalPlayer.Character then return false end

    local hum = CurrentTarget:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if hum:GetState() == Enum.HumanoidStateType.Dead then return false end

    if _G.EnableDistanceLimit and LocalPlayer.Character then
        local lp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if lp then
            if (TargetPart.Position - lp.Position).Magnitude > _G.MaxAimDistance then
                return false
            end
        end
    end
    return true
end

local function ShouldHit()
    if _G.HitChance >= 100 then return true end
    if _G.HitChance <= 0 then return false end
    return math.random(1, 100) <= _G.HitChance
end

-- ==================================================
-- Silent Aim Hook（与反作弊 Hook 兼容）
-- ==================================================

local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()

    -- 🛡️ Anti-Kick 拦截
    if _G.AntiKickEnabled then
        if method == "Kick" then
            return nil
        end
        if method == "FireServer" or method == "InvokeServer" then
            local name = ""
            if typeof(self) == "Instance" then
                name = string.lower(self.Name)
            else
                name = string.lower(tostring(self))
            end
            if string.find(name, "adonis") or string.find(name, "anticheat")
                or string.find(name, "validate") or string.find(name, "detect")
                or string.find(name, "punish") or string.find(name, "ban") then
                return nil
            end
        end
    end

    -- 🎯 Silent Aim 命中替换
    if _G.SilentAim and TargetPart and CurrentTarget then
        if not (_G.NoSelfAim and IsLocalCharacter(CurrentTarget)) then
            if method == "FireServer" or method == "InvokeServer" then
                local args = {...}
                if typeof(self) == "Instance" then
                    local n = self.Name:lower()
                    if n:find("fire") or n:find("hit") or n:find("attack") or n:find("damage") then
                        if ShouldHit() then
                            local newArgs = {}
                            local changed = false
                            for i, arg in ipairs(args) do
                                local t = typeof(arg)
                                if t == "Vector3" then
                                    newArgs[i] = TargetPart.Position; changed = true
                                elseif t == "CFrame" then
                                    newArgs[i] = CFrame.new(TargetPart.Position); changed = true
                                elseif t == "Ray" then
                                    newArgs[i] = Ray.new(arg.Origin, (TargetPart.Position - arg.Origin).Unit * 1000); changed = true
                                else
                                    newArgs[i] = arg
                                end
                            end
                            if changed then
                                return oldNamecall(self, unpack(newArgs))
                            end
                        end
                    end
                end
            end
        end
    end

    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

local oldIndex = mt.__index
setreadonly(mt, false)
mt.__index = newcclosure(function(self, key)
    if _G.SilentAim and TargetPart and CurrentTarget and self == Mouse then
        if not (_G.NoSelfAim and IsLocalCharacter(CurrentTarget)) then
            local kl = tostring(key):lower()
            if kl == "hit" then
                if ShouldHit() then return CFrame.new(TargetPart.Position) end
            elseif kl == "target" then
                return TargetPart
            end
        end
    end
    return oldIndex(self, key)
end)
setreadonly(mt, true)

