local function IsDead(character)
    if not character then return true end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return true end
    if humanoid.Health <= 0 then return true end
    if humanoid:GetState() == Enum.HumanoidStateType.Dead then return true end
    local bodyEffects = character:FindFirstChild("BodyEffects")
    if bodyEffects and bodyEffects:FindFirstChild("K.O") and bodyEffects["K.O"].Value == true then return true end
    local ko = character:FindFirstChild("K.O") or character:FindFirstChild("KO")
    if ko and (ko:IsA("BoolValue") or ko:IsA("IntValue")) and (ko.Value == true or ko.Value > 0) then return true end
    return false
end

local FriendCache = {}
local FriendCacheTime = 0
local FRIEND_CACHE_TTL = 30

local function IsFriend(player)
    if not player then return false end
    if not LocalPlayer or not LocalPlayer:IsA("Player") then return false end
    if player == LocalPlayer then return false end
    local now = os.clock()
    if now - FriendCacheTime > FRIEND_CACHE_TTL then
        FriendCache = {}; FriendCacheTime = now
    end
    if FriendCache[player.UserId] ~= nil then return FriendCache[player.UserId] end
    local result = false
    local success, isFriend = pcall(function() return LocalPlayer:IsFriendsWith(player.UserId) end)
    if success and isFriend then result = true end
    if not result then
        local s2, f2 = pcall(function() return LocalPlayer.FriendSystem:IsFriend(player) end)
        if s2 and f2 then result = true end
    end
    FriendCache[player.UserId] = result
    return result
end

local function IsInBlacklist(player)
