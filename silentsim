--// ==================== 基础工具 ====================
local function IsLocalCharacter(model)
    if not model then return true end
    return model == LocalPlayer.Character
end

local function IsAlive(model)
    if not model or not model.Parent then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if hum.Health <= 0 then return false end
    if hum:GetState() == Enum.HumanoidStateType.Dead then return false end
    return true
end

local function IsPlayerModel(model)
    return Players:GetPlayerFromCharacter(model) ~= nil
end

--// ==================== 核心扫描器 ====================
-- 极简：只扫 workspace 直接子级 + 一层文件夹/模型的子级
-- 不做 GetDescendants，不做递归，不做事件监听

local function TryAddNPC(model, cache)
    if not model or not model:IsA("Model") then return end
    if model == LocalPlayer.Character then return end
    if IsPlayerModel(model) then return end

    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if hum.Health <= 0 then return end
    if hum:GetState() == Enum.HumanoidStateType.Dead then return end

    local hrp = model:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    cache[model] = {Humanoid = hum, HRP = hrp}
end

local function ScanNPCs()
    local cache = {}

    local top = workspace:GetChildren()
    local topCount = #top

    for i = 1, topCount do
        local obj = top[i]
        TryAddNPC(obj, cache)

        -- 一层深：如果是文件夹/模型/配置，扫描其直接子级
        if obj:IsA("Folder") or obj:IsA("Model") or obj:IsA("Configuration") then
            local subs = obj:GetChildren()
            for j = 1, #subs do
                TryAddNPC(subs[j], cache)
            end
        end

        -- 分帧：每处理 40 个顶层对象 yield 一次
        if i % 40 == 0 then
            task.wait()
        end
    end

    -- 保留已在 ESP 中但当前扫描没找到的（可能是短暂失联），但 3 秒后丢弃
    -- 简化处理：直接替换
    ActiveNPCs = cache
    ScanCount = ScanCount + 1
end

local function ScanPlayers()
    local cache = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    cache[char] = {Humanoid = hum, HRP = hrp, Player = player}
                end
            end
        end
    end
    ActivePlayers = cache
end

--// ==================== 后台扫描循环 ====================
task.spawn(function()
    task.wait(1)
    while true do
        local ok, err = pcall(ScanNPCs)
        if not ok and _G.DebugMode then warn("[ScanNPCs]", err) end
        pcall(ScanPlayers)
        task.wait(_G.ScanInterval)
    end
end)

--// ==================== ESP 绘制对象池 ====================
local function NewPart(kind)
    local d = Drawing.new(kind)
    d.Visible = false
    d.Transparency = 1
    d.ZIndex = 2
    return d
end

local function GetESP(model)
    local e = ESP_Objects[model]
    if e then return e end
    e = {
        Box = NewPart("Square"),
        Line = NewPart("Line"),
        Stick = NewPart("Line"),
        Name = NewPart("Text"),
        Distance = NewPart("Text"),
        HPBack = NewPart("Square"),
        HPBar = NewPart("Square"),
        HPText = NewPart("Text"),
    }
    e.Box.Thickness = 1
    e.Box.Filled = false
    e.Line.Thickness = 1
    e.Stick.Thickness = 1
    e.Name.Center = true
    e.Name.Outline = true
    e.Name.Font = 2
    e.Name.Size = 15
    e.Distance.Center = true
    e.Distance.Outline = true
    e.Distance.Font = 2
    e.Distance.Size = 13
    e.HPBack.Filled = true
    e.HPBack.Color = Color3.fromRGB(0, 0, 0)
    e.HPBar.Filled = true
    e.HPText.Center = true
    e.HPText.Outline = true
    e.HPText.Font = 2
    e.HPText.Size = 12
    ESP_Objects[model] = e
    return e
end

local function HideESP(e)
    e.Box.Visible = false
    e.Line.Visible = false
    e.Stick.Visible = false
    e.Name.Visible = false
    e.Distance.Visible = false
    e.HPBack.Visible = false
    e.HPBar.Visible = false
    e.HPText.Visible = false
end

local function DestroyESPFor(model)
    local e = ESP_Objects[model]
    if not e then return end
    for _, obj in pairs(e) do
        pcall(function() obj:Remove() end)
    end
    ESP_Objects[model] = nil
end

--// ==================== ESP 更新 ====================
local function UpdateESPFor(model, data, isPlayer)
    local cfg = _G.ESP
    local hum = data.Humanoid
    local hrp = data.HRP

    local e = GetESP(model)
    local camPos = Camera.CFrame.Position

    -- 死亡隐藏
    if cfg.DeadCheck then
        if not hum or hum.Health <= 0 or not hum.Parent then
            HideESP(e); return
        end
        if hum:GetState() == Enum.HumanoidStateType.Dead then
            HideESP(e); return
        end
    end

    local dist = (hrp.Position - camPos).Magnitude
    if dist > cfg.MaxDistance then
        HideESP(e); return
    end

    local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
    if not onScreen then
        HideESP(e); return
    end

    local rootPos = Vector2.new(screenPos.X, screenPos.Y)
    local color = isPlayer and cfg.EnemyColor or cfg.EnemyColor

    -- 距离
    if cfg.ShowDistance then
        e.Distance.Position = rootPos - Vector2.new(0, 30)
        e.Distance.Color = Color3.fromRGB(255, 255, 255)
        e.Distance.Text = string.format("[%d]", math.floor(dist))
        e.Distance.Visible = true
    else
        e.Distance.Visible = false
    end

    -- 名字
    if cfg.ShowName then
        e.Name.Position = rootPos - Vector2.new(0, 45)
        e.Name.Color = color
        if isPlayer and data.Player then
            e.Name.Text = data.Player.Name
        else
            e.Name.Text = model.Name
        end
        e.Name.Visible = true
    else
        e.Name.Visible = false
    end

    -- 2D Box
    if cfg.ShowBox then
        local size = model:GetExtentsSize()
        local top = hrp.Position + Vector3.new(0, size.Y / 2, 0)
        local bottom = hrp.Position - Vector3.new(0, size.Y / 2, 0)
        local topV, on1 = Camera:WorldToViewportPoint(top)
        local botV, on2 = Camera:WorldToViewportPoint(bottom)
        if on1 and on2 then
            local h = math.abs(topV.Y - botV.Y)
            local w = h / 2
            e.Box.Size = Vector2.new(w, h)
            e.Box.Position = Vector2.new(rootPos.X - w / 2, topV.Y)
            e.Box.Color = color
            e.Box.Visible = true
        else
            e.Box.Visible = false
        end
    else
        e.Box.Visible = false
    end

    -- 顶部连线
    if cfg.ShowLine then
        e.Line.From = Vector2.new(Camera.ViewportSize.X / 2, 0)
        e.Line.To = rootPos
        e.Line.Color = cfg.LineColor
        e.Line.Visible = true
    else
        e.Line.Visible = false
    end

    -- Stick
    if cfg.ShowStick then
        local head = model:FindFirstChild("Head")
        if head then
            local hv, on1 = Camera:WorldToViewportPoint(head.Position)
            local fv, on2 = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 2, 0))
            if on1 and on2 then
                e.Stick.From = Vector2.new(hv.X, hv.Y)
                e.Stick.To = Vector2.new(fv.X, fv.Y)
                e.Stick.Color = cfg.StickColor
                e.Stick.Visible = true
            else
                e.Stick.Visible = false
            end
        else
            e.Stick.Visible = false
        end
    else
        e.Stick.Visible = false
    end

    -- HP
    if cfg.ShowHP then
        local hpRatio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
        local barW, barH = 60, 5
        local bx = rootPos.X - barW / 2
        local by = rootPos.Y + 5
        e.HPBack.Size = Vector2.new(barW, barH)
        e.HPBack.Position = Vector2.new(bx, by)
        e.HPBack.Visible = true
        e.HPBar.Size = Vector2.new(barW * hpRatio, barH)
        e.HPBar.Position = Vector2.new(bx, by)
        e.HPBar.Color = Color3.fromRGB(255 * (1 - hpRatio), 255 * hpRatio, 0)
        e.HPBar.Visible = true
        e.HPText.Position = Vector2.new(rootPos.X, by + barH + 4)
        e.HPText.Color = Color3.fromRGB(255, 255, 255)
        e.HPText.Text = string.format("%d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth))
        e.HPText.Visible = true
    else
        e.HPBack.Visible = false
        e.HPBar.Visible = false
        e.HPText.Visible = false
    end
end

local function UpdateESP()
    if not _G.ESP.Enabled then
        for _, e in pairs(ESP_Objects) do HideESP(e) end
        return
    end

    -- 更新 NPC
    if _G.ESP.ShowNPCs then
        for model, data in pairs(ActiveNPCs) do
            pcall(UpdateESPFor, model, data, false)
        end
    end

    -- 更新玩家
    if _G.ESP.ShowPlayers then
        for model, data in pairs(ActivePlayers) do
            pcall(UpdateESPFor, model, data, true)
        end
    end

    -- 隐藏不在缓存里的旧 ESP
    for model, e in pairs(ESP_Objects) do
        if not ActiveNPCs[model] and not ActivePlayers[model] then
            HideESP(e)
            if not model.Parent then
                DestroyESPFor(model)
            end
        end
    end
end

--// ==================== Silent Aim ====================
local function IsEnemyPlayer(player)
    if _G.NoSelfAim and player == LocalPlayer then return false end
    if not _G.TeamCheck then return true end
    if not LocalPlayer.Team or not player.Team then return true end
    if _G.FriendCheck then
        local ok, is = pcall(function() return LocalPlayer:IsFriendsWith(player.UserId) end)
        if ok and is then return false end
    end
    return LocalPlayer.Team ~= player.Team
end

local function GetAimPart(model)
    local ap = _G.AimPart
    if ap == "Head" then
        return model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
    elseif ap == "Torso" then
        return model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart")
    else
        return model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
    end
end

local function PickTarget()
    if not LocalPlayer.Character then return nil end
    local localRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not localRoot then return nil end
    local localPos = localRoot.Position

    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local bestScore = math.huge
    local bestModel, bestPart

    local function Consider(model, data, isPlayer)
        local hum = data.Humanoid
        local hrp = data.HRP
        if not hum or not hrp or hum.Health <= 0 then return end
        if _G.NoSelfAim and model == LocalPlayer.Character then return end

        if isPlayer then
            if not IsEnemyPlayer(data.Player) then return end
        else
            if _G.TeamCheckForNPCs then
                local t = model:FindFirstChild("Team")
                if t and t:IsA("StringValue") and LocalPlayer.Team and t.Value == LocalPlayer.Team.Name then
                    return
                end
            end
        end

        local dist = (hrp.Position - localPos).Magnitude
        if _G.EnableDistanceLimit and dist > _G.MaxAimDistance then return end

        local part = GetAimPart(model)
        if not part then return end
        local aimPos = part.Position
        if _G.Prediction > 0 and hrp.Velocity.Magnitude > 1 then
            aimPos = aimPos + hrp.Velocity * _G.Prediction
        end

        local screenPos, onScreen = Camera:WorldToViewportPoint(aimPos)
        if not onScreen then return end

        local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
        if distFromCenter > _G.FOV then return end

        local score
        if _G.TargetPriority == "Crosshair" then score = distFromCenter
        elseif _G.TargetPriority == "Distance" then score = dist
        elseif _G.TargetPriority == "LowestHP" then score = hum.Health
        else score = distFromCenter end

        if score < bestScore then
            bestScore = score
            bestModel = model
            bestPart = part
        end
    end

    if _G.TargetMode == "NPCs" or _G.TargetMode == "Both" then
        for model, data in pairs(ActiveNPCs) do
            Consider(model, data, false)
        end
    end
    if _G.TargetMode == "Players" or _G.TargetMode == "Both" then
        for model, data in pairs(ActivePlayers) do
            Consider(model, data, true)
        end
    end

    return bestModel, bestPart
end

local function ValidateCurrent()
    if not CurrentTarget or not TargetPart then return false end
    if not CurrentTarget.Parent or not TargetPart.Parent then return false end
    if _G.NoSelfAim and CurrentTarget == LocalPlayer.Character then return false end

    local hum = CurrentTarget:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if hum:GetState() == Enum.HumanoidStateType.Dead then return false end

    if _G.EnableDistanceLimit and LocalPlayer.Character then
        local lp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if lp then
            if (TargetPart.Position - lp.Position).Magnitude > _G.MaxAimDistance then
                return false
            end
        end
    end
    return true
end

--// ==================== 命中判定 ====================
local function ShouldHit()
    if _G.HitChance >= 100 then return true end
    if _G.HitChance <= 0 then return false end
    return math.random(1, 100) <= _G.HitChance
end

--// ==================== Hook ====================
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if _G.SilentAim and TargetPart and CurrentTarget then
        if not (_G.NoSelfAim and IsLocalCharacter(CurrentTarget)) then
            if method == "FireServer" or method == "InvokeServer" then
                local args = {...}
                if typeof(self) == "Instance" then
                    local n = self.Name:lower()
                    if n:find("fire") or n:find("hit") or n:find("attack") or n:find("damage") then
                        if ShouldHit() then
                            local newArgs = {}
                            local changed = false
                            for i, arg in ipairs(args) do
                                local t = typeof(arg)
                                if t == "Vector3" then
                                    newArgs[i] = TargetPart.Position; changed = true
                                elseif t == "CFrame" then
                                    newArgs[i] = CFrame.new(TargetPart.Position); changed = true
                                elseif t == "Ray" then
                                    newArgs[i] = Ray.new(arg.Origin, (TargetPart.Position - arg.Origin).Unit * 1000); changed = true
                                else
                                    newArgs[i] = arg
                                end
                            end
                            if changed then
                                setreadonly(mt, true)
                                local r = oldNamecall(self, unpack(newArgs))
                                setreadonly(mt, false)
                                return r
                            end
                        end
                    end
                end
            end
        end
    end
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

local oldIndex
setreadonly(mt, false)
oldIndex = mt.__index
mt.__index = newcclosure(function(self, key)
    if _G.SilentAim and TargetPart and CurrentTarget and self == Mouse then
        if not (_G.NoSelfAim and IsLocalCharacter(CurrentTarget)) then
            local kl = tostring(key):lower()
            if kl == "hit" then
                if ShouldHit() then return CFrame.new(TargetPart.Position) end
            elseif kl == "target" then
                return TargetPart
            end
        end
    end
    return oldIndex(self, key)
end)
setreadonly(mt, true)

