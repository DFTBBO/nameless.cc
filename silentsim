    else
        Circle.Visible = false
    end

    if FrameCounter % 2 == 0 then
        UpdateTargetInfo()
    end
    if FrameCounter % 15 == 0 then
        UpdateHighlight()
    end

    if FrameCounter % _G.ESPFrameInterval == 0 then
        pcall(updateESP)
    end
end)

